# En local, laisse ces deux variables vides : l'app utilise alors un fichier
# SQLite local (data/cv-builder.db), exactement comme avant.
#
# Sur Vercel, renseigne-les avec les identifiants de ta base Turso
# (voir `turso db show <nom> --url` et `turso db tokens create <nom>`).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret utilisé pour signer le cookie de session (chaque CV a son
# propre code à 8 chiffres, stocké haché en base — pas de PIN global ici).
# Mets une vraie valeur aléatoire en production.
SESSION_SECRET=
